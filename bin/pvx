#!/usr/bin/env bash
# bin/pvx — dispatcher da CLI unificada de suporte técnico Phonevox.
set -Eeuo pipefail
shopt -s extglob

if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 2) )); then
  printf 'pvx: requer bash >= 4.2 (detectado %s)\n' "$BASH_VERSION" >&2
  exit 78
fi

# --- resolve PVX_ROOT/PVX_LIB_DIR de forma symlink-safe --------------------------------------
# Funciona a partir de /usr/local/bin/pvx (symlink), /opt/pvx/current/bin/pvx, ou um checkout
# de desenvolvimento — sem hardcode de caminho absoluto.
_pvx_resolve_root() {
  local src=${BASH_SOURCE[0]} dir
  while [[ -L $src ]]; do
    dir=$(cd -P "${src%/*}" 2>/dev/null && pwd)
    src=$(readlink "$src")
    [[ $src != /* ]] && src="$dir/$src"
  done
  PVX_BIN_DIR=$(cd -P "${src%/*}" && pwd)
  PVX_ROOT=${PVX_BIN_DIR%/*}
}
_pvx_resolve_root
: "${PVX_LIB_DIR:=$PVX_ROOT/lib}"
export PVX_ROOT PVX_LIB_DIR PVX_BIN_DIR

if [[ ! -r "$PVX_LIB_DIR/bootstrap.sh" ]]; then
  printf 'pvx: lib ausente: %s/bootstrap.sh (instalação quebrada?)\n' "$PVX_LIB_DIR" >&2
  exit 78
fi
# shellcheck source=/dev/null
source "$PVX_LIB_DIR/bootstrap.sh"
pvx::require_bash 4 2

if [[ -r "$PVX_ROOT/VERSION" ]]; then
  read -r PVX_VERSION <"$PVX_ROOT/VERSION"
else
  PVX_VERSION='0.0.0-dev'
fi
export PVX_VERSION

: "${PVX_ROOT_PREFIX:=}"
: "${PVX_STATE_DIR:=${PVX_ROOT_PREFIX}/var/lib/pvx}"
: "${PVX_CACHE_DIR:=${PVX_ROOT_PREFIX}/var/cache/pvx}"
: "${PVX_ETC_DIR:=${PVX_ROOT_PREFIX}/etc/pvx}"
: "${PVX_MODULES_DIR:=${PVX_ROOT_PREFIX}/opt/pvx/modules}"
export PVX_ROOT_PREFIX PVX_STATE_DIR PVX_CACHE_DIR PVX_ETC_DIR PVX_MODULES_DIR

PVX_DRY_RUN=${PVX_DRY_RUN:-0}
PVX_ASSUME_YES=${PVX_ASSUME_YES:-0}
PVX_OFFLINE=${PVX_OFFLINE:-0}
PVX_NONINTERACTIVE=${PVX_NONINTERACTIVE:-0}
export PVX_DRY_RUN PVX_ASSUME_YES PVX_OFFLINE PVX_NONINTERACTIVE

pvx::require color log os paths exec flags tui
pvx::install_traps # já pré-aquece invocation_id/tmpdir num shell não-subshell

# --- resolução de comando: extensível via este array (novo tipo = +1 função) -----------------
declare -ga PVX_RESOLVERS=(core::resolve registry::resolve snippet::resolve)

# valor "file:function" — lib/core/<file>.sh é sourced sob demanda, só quando o comando roda.
declare -gA PVX_CORE_CMDS=(
  [help]='core/help:core::cmd_help'
  [version]='core/version:core::cmd_version'
  [modules]='cmd_modules:core::cmd_modules'
  [completion]='core/completion:core::cmd_completion'
  [registry]='core/registry:core::cmd_registry'
  [tests]='core/tests:core::cmd_tests'
  [doctor]='core/reserved:core::cmd_reserved'
  [config]='core/reserved:core::cmd_reserved'
  [cache]='core/reserved:core::cmd_reserved'
  [paths]='core/reserved:core::cmd_reserved'
  [log]='core/reserved:core::cmd_reserved'
  [update]='core/update:core::cmd_update'
)
declare -gA PVX_CORE_NEEDS_ROOT=()

core::resolve() {
  local cmd=$1
  [[ -n ${PVX_CORE_CMDS[$cmd]:-} ]] || return 1
  printf 'core:%s\n' "${PVX_CORE_CMDS[$cmd]}"
}

# Despacho O(1) de módulo instalado: symlink em $PVX_STATE_DIR/commands/<cmd> -> entrypoint.
# Não depende de lib/registry.sh existir — é só um fato do sistema de arquivos.
registry::resolve() {
  local cmd=$1
  local link="$PVX_STATE_DIR/commands/$cmd"
  [[ -L $link || -x $link ]] || return 1
  printf 'module:%s\n' "$link"
}

# Snippet embutido: arquivo único em share/pvx/snippets/<cmd>.sh, roda in-process (sourced).
snippet::resolve() {
  local cmd=$1
  local f="$PVX_ROOT/share/pvx/snippets/$cmd.sh"
  [[ -r $f ]] || return 1
  printf 'snippet:%s\n' "$f"
}

core::_suggest() {
  local cmd=$1 c best='' candidates=()
  candidates+=("${!PVX_CORE_CMDS[@]}")
  if [[ -d $PVX_STATE_DIR/commands ]]; then
    for c in "$PVX_STATE_DIR"/commands/*; do
      [[ -e $c || -L $c ]] && candidates+=("${c##*/}")
    done
  fi
  if [[ -d "$PVX_ROOT/share/pvx/snippets" ]]; then
    for c in "$PVX_ROOT"/share/pvx/snippets/*.sh; do
      [[ -e $c ]] || continue
      c=${c##*/}
      candidates+=("${c%.sh}")
    done
  fi
  for c in ${candidates[@]+"${candidates[@]}"}; do
    if [[ $c == "$cmd"* || ( -n $cmd && $c == *"$cmd"* ) ]]; then
      best=$c
      break
    fi
  done
  printf 'pvx: comando desconhecido: %s\n' "$cmd" >&2
  [[ -n $best ]] && printf "você quis dizer '%s'?\\n" "$best" >&2
  return 0
}

# core::_menu_build_options — (re)popula `options`/`cmd_names` (arrays já declaradas pelo
# chamador, core::_interactive_menu — escrito assim, sem `local` aqui dentro, de propósito:
# bash resolve `options`/`cmd_names` pelo escopo dinâmico do chamador, então esta função só
# preenche as arrays que já existem lá, sem precisar de nameref (que pediria bash >=4.3; o
# projeto trava em >=4.2, ver pvx::require_bash 4 2 logo no topo deste arquivo)). Extraído pra
# função separada só pra poder ser chamado DE NOVO depois de um submenu "owned" (modules/
# registry/completion) retornar — ver o comentário no loop de core::_interactive_menu.
core::_menu_build_options() {
  local -A core_descriptions=(
    [modules]='consulta e configurações de módulos'
    [registry]='configuração do índice de módulos'
    [completion]='gera ou instala o script de autocomplete de comandos'
    [tests]='roda a suíte de testes do pvx-core (units/suites)'
    [update]='atualizações do pvxcli e/ou módulos instalados'
    [help]='exibe a ajuda'
    [version]='exibe a versão desta ferramenta'
  )
  local -a core_order=(modules registry completion tests update help version)
  # curada só pra descrição amigável — qualquer snippet sem entrada aqui ainda aparece, com
  # descrição genérica ("comando builtin"), ver o loop de "snippets" abaixo.
  local -A snippet_descriptions=([sysinfo]='informações sobre o sistema')
  local c f

  options=()
  cmd_names=()

  # Três grupos, sempre nesta ordem, cada um com seu próprio `tui::header` — SEPARAÇÃO CLARA
  # entre "comandos" (core, embutido no próprio bin/pvx), "módulos" (instalados via `pvx
  # modules install`, processo/versão/hooks próprios) e "snippets" (arquivo único em
  # share/pvx/snippets/, in-process, sem ciclo de vida) — são três conceitos diferentes (ver
  # MODULE_DEVELOPMENT.md §1-2), o menu não devia misturar tudo numa lista só.
  local -a grp=()

  # --- comandos (core) ------------------------------------------------------------------------
  grp=()
  for c in "${core_order[@]}"; do
    # install.sh copia tests/ de propósito — numa instalação normal esta checagem sempre
    # passa. Só falta em release antigo/instalação incompleta (ver lib/core/tests.sh); nesse
    # caso, esconde a opção em vez de listar algo que sempre daria erro.
    [[ $c == tests && ! -x "$PVX_ROOT/tests/run" ]] && continue
    [[ -n ${PVX_CORE_CMDS[$c]:-} ]] || continue
    grp+=("$c")
  done
  if ((${#grp[@]})); then
    options+=("$(tui::header comandos)")
    cmd_names+=('')
    for c in "${grp[@]}"; do
      options+=("$(printf '%-12s %s' "$c" "${core_descriptions[$c]:-}")")
      cmd_names+=("$c")
    done
  fi

  # --- módulos instalados ----------------------------------------------------------------------
  grp=()
  if [[ -d $PVX_STATE_DIR/commands ]]; then
    for c in "$PVX_STATE_DIR"/commands/*; do
      [[ -e $c || -L $c ]] && grp+=("${c##*/}")
    done
  fi
  if ((${#grp[@]})); then
    options+=("$(tui::header módulos)")
    cmd_names+=('')
    for c in "${grp[@]}"; do
      local meta_file="$PVX_STATE_DIR/modules/$c/module.json" summary=''
      [[ -r $meta_file ]] && summary=$(core::_module_field_grep "$meta_file" summary)
      options+=("$(printf '%-12s %s' "$c" "${summary:-módulo instalado}")")
      cmd_names+=("$c")
    done
  fi

  # --- snippets --------------------------------------------------------------------------------
  grp=()
  if [[ -d "$PVX_ROOT/share/pvx/snippets" ]]; then
    for f in "$PVX_ROOT"/share/pvx/snippets/*.sh; do
      [[ -e $f ]] && grp+=("$(basename "$f" .sh)")
    done
  fi
  if ((${#grp[@]})); then
    options+=("$(tui::header snippets)")
    cmd_names+=('')
    for f in "${grp[@]}"; do
      options+=("$(printf '%-12s %s' "$f" "${snippet_descriptions[$f]:-comando builtin}")")
      cmd_names+=("$f")
    done
  fi
}

# core::_interactive_menu — `pvx` sem nenhum comando, com TTY de verdade dos dois lados: em
# vez do texto de ajuda estático, sobe um menu (lib/tui.sh) listando todo comando válido —
# core, módulo instalado, snippet — e roda o escolhido como um processo novo (não `exec`, de
# propósito: assim volta pro menu depois, em vez de encerrar o pvx junto com o comando).
# Sem TTY (script/cron/CI), cai no help de texto de sempre — nunca fica esperando teclado.
core::_interactive_menu() {
  pvx::require tui core/self_update cmd_modules

  # best-effort, cacheado (PVX_SELF_UPDATE_TTL) — só bate na rede se o cache expirou, e nunca
  # atrapalha a abertura do menu se a rede falhar (ver core::_self_update_notify).
  core::_self_update_notify || true
  # mesmo padrão, mas pros MÓDULOS instalados (registry ou git direto) — ver
  # modules::_updates_notify em lib/cmd_modules.sh.
  modules::_updates_notify || true

  # rede de segurança: cada tui::select/checklist/pause já restaura a própria stty sozinho no
  # caminho normal (inclusive em Ctrl-C, ver o comentário em tui::_select_tty) — isso aqui é só
  # a garantia de que, mesmo se algum bug/corrida escapar disso em qualquer nível de submenu, o
  # terminal nunca fica preso em modo raw depois que o pvx sai: captura o estado UMA vez ao
  # entrar no menu, e devolve no exit do processo, não importa por onde ele saiu.
  #
  # SEM "local" de propósito: o hook de exit só roda DEPOIS que esta função já retornou (o
  # `trap EXIT` dispara no fim do processo inteiro, não no fim desta função) — uma variável
  # `local` já teria saído de escopo a essa altura, e o hook quebraria com "unbound variable"
  # sob `set -u` (achado de verdade rodando no container: o hook falhava antes até de chegar
  # no `stty`, deixando o terminal exatamente tão travado quanto sem rede de segurança nenhuma).
  PVX_MENU_STTY_SAVED=$(stty -g 2>/dev/null) || PVX_MENU_STTY_SAVED=''
  if [[ -n $PVX_MENU_STTY_SAVED ]]; then
    core::_menu_stty_restore() {
      stty "$PVX_MENU_STTY_SAVED" 2>/dev/null || true
      return 0
    }
    pvx::on_exit core::_menu_stty_restore
  fi

  local -a options=() cmd_names=()
  core::_menu_build_options

  if ((${#options[@]} == 0)); then
    pvx::_print_help
    return 0
  fi

  # comandos que sabem abrir o próprio submenu quando chamados sem subcomando (ver
  # modules::_interactive_menu, core::_registry_interactive_menu,
  # core::_completion_interactive_menu) — rodam in-process via core::_run_owned_submenu, que
  # empilha/desempilha nível de menu sem reexecutar todo o bin/pvx. Já cuidam sozinhos das
  # próprias pausas; rodar de novo a pausa "pressione enter" aqui embaixo só ecoaria vazio
  # depois de voltar de um submenu cancelado.
  local -A owned_submenus=([modules]=1 [registry]=1 [completion]=1)

  # Esses três têm saída curta e nenhum estado próprio pra ler com calma (diferente de
  # "tests", que abre o próprio menu multi-tela do tests/run, ou de um módulo instalado, cuja
  # saída pode ser longa/importante de ler) — voltam pro menu principal sozinhos, sem precisar
  # de nenhuma tecla.
  local -A instant_return=([sysinfo]=1 [help]=1 [version]=1)

  local i chosen_cmd
  while true; do
    tui::clearscr
    if ! tui::select "$(tui::breadcrumb)" "${options[@]}"; then
      return 0
    fi
    chosen_cmd=''
    for ((i = 0; i < ${#options[@]}; i++)); do
      if [[ ${options[i]} == "$TUI_CHOICE" ]]; then
        chosen_cmd=${cmd_names[i]}
        break
      fi
    done
    [[ -z $chosen_cmd ]] && continue

    printf '\n'

    if [[ -n ${owned_submenus[$chosen_cmd]:-} ]]; then
      core::_run_owned_submenu "$chosen_cmd"
      # reconstrói options/cmd_names: só "modules" muda a lista de comandos de verdade
      # (install/remove), mas refaz sempre — custo é só alguns grep/stat locais, e evita ter
      # que lembrar de atualizar isto de novo se "registry"/"completion" um dia passarem a
      # afetar a lista também. Achado de verdade: sem isto, um módulo instalado por aqui (ex.:
      # "modules > install > from url") só aparecia no menu depois de sair e abrir o pvx de
      # novo (processo novo) — options/cmd_names eram montadas uma vez só, antes deste loop.
      core::_menu_build_options
      continue
    fi

    # "|| true" de propósito: sob set -e, um comando solto que retorna != 0 derruba o processo
    # inteiro pela trap de ERR em vez de só terminar o comando escolhido — mesma classe de bug
    # já corrigida nos submenus de modules/registry/completion (ver docs/interactive-menu-spec.md).
    # Módulo instalado que sai != 0 (ex: preflight recusando por falta de rede) é um caso real,
    # não só teórico — precisa voltar pro menu, não matar a sessão inteira do pvx.
    "$PVX_BIN_DIR/pvx" "$chosen_cmd" || true

    if [[ -n ${instant_return[$chosen_cmd]:-} ]]; then
      printf '\n'
      continue
    fi

    tui::pause 'pressione qualquer tecla para continuar'
    ((TUI_BACK)) && return 0
  done
}

# core::_run_owned_submenu <cmd> — chama a função core do comando (que já sabe abrir seu
# próprio submenu quando não recebe subcomando algum) direto no processo atual, em vez de via
# subprocesso — é isso que permite empilhar/desempilhar nível de menu sem reexecutar bin/pvx.
core::_run_owned_submenu() {
  local cmd=$1 target file fn
  target=${PVX_CORE_CMDS[$cmd]}
  file=${target%%:*}
  fn=${target#*:}
  pvx::require "$file"
  local saved_ctx=$PVX_LOG_CONTEXT
  PVX_LOG_CONTEXT=$cmd
  # "|| true": defesa em profundidade — cada submenu (modules/registry/completion) já garante
  # rc=0 em todo caminho interativo, mas um comando solto sob `set -e` derruba o pvx inteiro se
  # ISSO algum dia deixar de valer; melhor um "continue" silencioso aqui do que um crash.
  "$fn" || true
  PVX_LOG_CONTEXT=$saved_ctx
  return 0
}

# Resolve o <name> do módulo a partir do symlink de despacho (aponta pra dentro de
# $PVX_MODULES_DIR/<name>/...) — evita ter que reparsear module.json inteiro só pra achar o
# próprio nome do módulo.
core::_module_name_from_cmd() {
  local cmd=$1 link target
  link="$PVX_STATE_DIR/commands/$cmd"
  [[ -L $link ]] || return 1
  target=$(readlink "$link" 2>/dev/null) || return 1
  [[ $target == */modules/* ]] || return 1
  target=${target#*/modules/}
  printf '%s\n' "${target%%/*}"
}

# Extrai um campo de string simples (top-level, não aninhado) de um module.json via grep —
# evita carregar lib/json.sh só pra isso no caminho quente do dispatch de todo comando.
core::_module_field_grep() {
  local meta_file=$1 field=$2
  grep -Eo "\"$field\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$meta_file" 2>/dev/null | head -1 |
    sed -E 's/.*:[[:space:]]*"([^"]*)"/\1/'
}

# Popula PVX_MODULE_{NAME,VERSION,DIR,STATE_DIR} pro contrato de env do módulo — chamado antes
# de despachar pra um módulo (tanto na invocação normal quanto na ação `logs`).
#
# Garante (mkdir -p) o state dir aqui, TODA vez que o módulo é despachado, se "state_dir": true
# — não só uma vez no install. Achado de verdade: antes disso, só modules::_publish_staging
# (lib/cmd_modules.sh, no exato momento do install) criava o diretório; modules::_apply_update_
# from_staging (update) nunca recriava, e uma ação normal do módulo (o caminho mais comum de
# todos) nunca garantia nada — PVX_MODULE_STATE_DIR sempre era exportado, mas o diretório podia
# simplesmente não existir. Todo hook/ação que escrevia lá tinha que se defender sozinho com o
# próprio "mkdir -p" (ver hooks/install do dummy/netinstall) — a flag "state_dir: true"
# praticamente não entregava a garantia que o nome sugere. Agora ela entrega de verdade: um
# "mkdir -p" é barato/idempotente, então garantir de novo em toda invocação não tem custo real.
core::_module_export_env() {
  local cmd=$1
  PVX_MODULE_NAME=$(core::_module_name_from_cmd "$cmd") || PVX_MODULE_NAME=''
  PVX_MODULE_VERSION=''
  PVX_MODULE_DIR=''
  PVX_MODULE_STATE_DIR=''
  if [[ -n $PVX_MODULE_NAME ]]; then
    local meta_file="$PVX_STATE_DIR/modules/$PVX_MODULE_NAME/module.json"
    [[ -r $meta_file ]] && PVX_MODULE_VERSION=$(core::_module_field_grep "$meta_file" version)
    PVX_MODULE_DIR="$PVX_MODULES_DIR/$PVX_MODULE_NAME"
    PVX_MODULE_STATE_DIR="$PVX_STATE_DIR/state/$PVX_MODULE_NAME"
    core::_module_wants_state_dir "$cmd" && mkdir -p "$PVX_MODULE_STATE_DIR" 2>/dev/null
  fi
  export PVX_MODULE_NAME PVX_MODULE_VERSION PVX_MODULE_DIR PVX_MODULE_STATE_DIR
  return 0
}

# Checagem leve via grep (não carrega lib/json.sh — evita o custo de parse só pra um boolean
# em TODA invocação de comando de módulo). O metadado é a cópia de module.json que
# lib/cmd_modules.sh grava em $PVX_STATE_DIR/modules/<name>/ no momento da instalação.
core::_module_requires_root() {
  local cmd=$1 name meta_file
  name=$(core::_module_name_from_cmd "$cmd") || return 1
  meta_file="$PVX_STATE_DIR/modules/$name/module.json"
  [[ -r $meta_file ]] || return 1
  grep -Eq '"requires_root"[[:space:]]*:[[:space:]]*true' "$meta_file"
}

# Mesmo padrão de core::_module_requires_root, pro campo "state_dir" — ver o comentário em
# core::_module_export_env pro porquê disso ser checado em toda invocação, não só no install.
core::_module_wants_state_dir() {
  local cmd=$1 name meta_file
  name=$(core::_module_name_from_cmd "$cmd") || return 1
  meta_file="$PVX_STATE_DIR/modules/$name/module.json"
  [[ -r $meta_file ]] || return 1
  grep -Eq '"state_dir"[[:space:]]*:[[:space:]]*true' "$meta_file"
}

# hook opcional `hooks.logs` de um módulo "serviço" — se declarado no module.json e existir/for
# executável, o dispatcher chama ele em vez do log::tail genérico.
core::_module_logs_hook() {
  local cmd=$1 name meta_file hook_rel hook_path
  name=$(core::_module_name_from_cmd "$cmd") || return 1
  meta_file="$PVX_STATE_DIR/modules/$name/module.json"
  [[ -r $meta_file ]] || return 1
  hook_rel=$(grep -Eo '"logs"[[:space:]]*:[[:space:]]*"[^"]*"' "$meta_file" 2>/dev/null |
    sed -E 's/.*:[[:space:]]*"([^"]*)"/\1/') || return 1
  [[ -n $hook_rel ]] || return 1
  hook_path="$PVX_MODULES_DIR/$name/$hook_rel"
  [[ -x $hook_path ]] || return 1
  printf '%s\n' "$hook_path"
}

core::_check_root() {
  local cmd=$1 kind=$2 needs=0
  case $kind in
    core) [[ -n ${PVX_CORE_NEEDS_ROOT[$cmd]:-} ]] && needs=1 ;;
    module) core::_module_requires_root "$cmd" && needs=1 ;;
  esac
  (( needs )) || return 0
  if (( EUID != 0 )); then
    log::error '%s requer privilégios de root (rodando como uid %d)' "$cmd" "$EUID"
    log::hint "tente: sudo pvx $cmd"
    exit "$PVX_EXIT_NOPERM"
  fi
}

# --- config: parseada, nunca sourced (source de config seria RCE como root) ------------------
pvx::_load_config() {
  local file=${PVX_CONFIG_FILE:-$PVX_ETC_DIR/pvx.conf} k v perm
  [[ -r $file ]] || return 0
  perm=$(stat -c '%a' "$file" 2>/dev/null) || perm=''
  if [[ -n $perm && ${perm: -1} =~ [2367] ]]; then
    log::warn 'config %s é world-writable; ignorando por segurança' "$file"
    return 0
  fi
  while IFS='=' read -r k v; do
    k=${k%%#*}
    k=${k//[[:space:]]/}
    [[ -z $k ]] && continue
    v=${v%%#*}
    v=${v#"${v%%[![:space:]]*}"}
    v=${v%"${v##*[![:space:]]}"}
    case $k in
      log_level) log::set_level "$v" ;;
      log_dir) PVX_LOG_DIR=$v ;;
      log_retention_days) PVX_LOG_RETENTION_DAYS=$v ;;
      color) color::set_mode "$v" ;;
      offline) [[ $v == true || $v == 1 ]] && PVX_OFFLINE=1 ;;
      auto_sudo) [[ $v == true || $v == 1 ]] && PVX_AUTO_SUDO=1 ;;
      tui) PVX_TUI=$v ;;
      registry_url) PVX_REGISTRY_URL=$v ;;
      module_git_shorthand_base) PVX_MODULE_GIT_SHORTHAND_BASE=$v ;;
      self_update_url) PVX_SELF_UPDATE_URL=$v ;;
      self_update_check_ttl) PVX_SELF_UPDATE_TTL=$v ;;
    esac
  done <"$file"
  return 0
}

pvx::_print_version() {
  printf 'pvx %s\n' "$PVX_VERSION"
}

pvx::_print_help() {
  cat <<'EOF'
uso: pvx [opções globais] <comando> [args...]

sem nenhum comando, num terminal interativo, "pvx" sozinho abre um menu pra escolher o
que fazer em vez de mostrar este texto.

comandos:
  modules     gerencia módulos instaláveis (list/install/remove/update/help)
  registry    consulta/configura o índice remoto de módulos (status/list/refresh/set)
  sysinfo     dump read-only de informações do sistema, ponto de partida de debugging
  completion  gera/instala o script de autocomplete do bash
  tests       roda a suíte de testes do pvx-core (list/run all/run units/run suites)
  update      atualiza o pvx-core e os módulos instalados (subcomandos: core|self, modules)
  help        mostra esta ajuda ou --help de um comando
  version     mostra a versão do pvx

opções globais:
  -h, --help         mostra esta ajuda
  -V, --version      mostra a versão
  -v, --verbose      aumenta verbosidade (equivalente a --log-level=debug)
  -q, --quiet        reduz verbosidade (equivalente a --log-level=error)
      --debug        equivalente a --log-level=debug
      --trace        equivalente a --log-level=trace
      --log-level=N  define o nível de log do console (trace/debug/info/warn/error)
      --color=X      auto|always|never
      --no-color     equivalente a --color=never
  -n, --dry-run      não executa ações que mutam estado
  -y, --yes          assume "sim" em confirmações interativas
      --offline      nunca tenta acesso de rede
      --config FILE  usa um arquivo de config alternativo

todo comando (core ou módulo instalado) também aceita a ação especial "logs" para
acompanhar seus logs em tempo real, ex: pvx modules logs
EOF
}

# core::_show_ascii_art <arquivo> — imprime o arquivo (ASCII.txt na raiz do pvx-core, por
# padrão) seguido de uma linha em branco. Chamada SÓ no exato momento de entrar no modo
# interativo (pvx sem comando nenhum, terminal de verdade nos dois lados) — nunca pra um
# comando composto tipo "pvx modules list" ou "pvx registry list", mesmo sendo tecnicamente a
# primeira invocação do binário: eles não entram no modo interativo, então não mostram nada
# (achado de verdade testando no container — a ideia é a arte anunciar "você entrou no menu",
# não "você chamou o binário"). Ver a chamada em main(), dentro do bloco `[[ -z $cmd ]]`.
# A flag oculta --loadascii <arquivo> (não documentada em --help, de propósito) chama isto
# direto, ignorando tudo isso — útil pra testar a arte sem precisar entrar no menu. Nunca
# falha se o arquivo não existir (ex: checkout sem ASCII.txt ainda) — só não mostra.
core::_show_ascii_art() {
  local file=$1
  [[ -r $file ]] || return 0
  cat "$file"
  printf '\n'
  return 0
}

main() {
  local -a argv=("$@")
  local -a rest=()
  local i=0 a

  # pré-scan só de --config, pra carregar o arquivo certo antes do resto
  for ((i = 0; i < ${#argv[@]}; i++)); do
    if [[ ${argv[i]} == --config && -n ${argv[i+1]:-} ]]; then
      PVX_CONFIG_FILE=${argv[i+1]}
      break
    fi
  done

  color::init # precisa rodar antes de qualquer color::set_mode (inclusive vindo da config)
  pvx::_load_config
  log::init

  i=0
  while (( i < ${#argv[@]} )); do
    a=${argv[i]}
    case $a in
      -h | --help)
        pvx::_print_help
        exit 0
        ;;
      -V | --version)
        pvx::_print_version
        exit 0
        ;;
      -v | --verbose) log::set_level debug ;;
      -q | --quiet) log::set_level error ;;
      --debug) log::set_level debug ;;
      --trace) log::set_level trace ;;
      --log-level=*) log::set_level "${a#*=}" ;;
      --color=*) color::set_mode "${a#*=}" ;;
      --no-color) color::set_mode never ;;
      -n | --dry-run) PVX_DRY_RUN=1 ;;
      -y | --yes) PVX_ASSUME_YES=1 ;;
      --offline) PVX_OFFLINE=1 ;;
      --config) i=$((i + 1)) ;; # valor já consumido no pré-scan
      --loadascii)
        PVX_LOADASCII_FILE=${argv[i+1]:-}
        i=$((i + 1))
        ;;
      --)
        i=$((i + 1))
        while (( i < ${#argv[@]} )); do
          rest+=("${argv[i]}")
          i=$((i + 1))
        done
        break
        ;;
      -*)
        printf 'pvx: opção global desconhecida: %s\n' "$a" >&2
        exit "$PVX_EXIT_USAGE"
        ;;
      *)
        while (( i < ${#argv[@]} )); do
          rest+=("${argv[i]}")
          i=$((i + 1))
        done
        break
        ;;
    esac
    i=$((i + 1))
  done
  export PVX_DRY_RUN PVX_ASSUME_YES PVX_OFFLINE

  # --loadascii força a exibição na hora, não importa se o resto é um comando composto ou não
  # (flag de teste, ignora a regra de "só no modo interativo" de propósito).
  [[ -n ${PVX_LOADASCII_FILE:-} ]] && core::_show_ascii_art "$PVX_LOADASCII_FILE"

  local cmd=${rest[0]:-}
  local -a cmd_args=(${rest[@]+"${rest[@]:1}"})

  if [[ -z $cmd ]]; then
    if tui::is_interactive; then
      # só aqui: entrando de verdade no modo interativo, não num comando composto qualquer
      # (ex: "pvx modules list" nunca mostra, mesmo sendo a primeira chamada do binário).
      [[ -z ${PVX_LOADASCII_FILE:-} ]] && core::_show_ascii_art "$PVX_ROOT/ASCII.txt"
      core::_interactive_menu
      exit $?
    fi
    pvx::_print_help
    exit 0
  fi
  PVX_CURRENT_CMD=$cmd

  local resolver resolved='' kind='' target=''
  for resolver in "${PVX_RESOLVERS[@]}"; do
    if resolved=$("$resolver" "$cmd" 2>/dev/null); then
      kind=${resolved%%:*}
      target=${resolved#*:}
      break
    fi
  done

  if [[ -z $kind ]]; then
    core::_suggest "$cmd"
    exit "$PVX_EXIT_NOTFOUND"
  fi

  core::_check_root "$cmd" "$kind"

  if [[ ${cmd_args[0]:-} == logs ]]; then
    local hook=''
    [[ $kind == module ]] && { hook=$(core::_module_logs_hook "$cmd") || hook=''; }
    if [[ -n $hook ]]; then
      core::_module_export_env "$cmd"
      exec "$hook" ${cmd_args[@]+"${cmd_args[@]:1}"}
    fi
    local logs_rc=0
    log::tail "$cmd" ${cmd_args[@]+"${cmd_args[@]:1}"} || logs_rc=$?
    exit "$logs_rc"
  fi

  local rc=0
  case $kind in
    core)
      local file=${target%%:*} fn=${target#*:}
      pvx::require "$file"
      local saved_ctx=$PVX_LOG_CONTEXT
      PVX_LOG_CONTEXT=$cmd
      "$fn" ${cmd_args[@]+"${cmd_args[@]}"} && rc=0 || rc=$?
      PVX_LOG_CONTEXT=$saved_ctx
      ;;
    module)
      core::_module_export_env "$cmd"
      PVX_LOG_CONTEXT=$cmd "$target" ${cmd_args[@]+"${cmd_args[@]}"} && rc=0 || rc=$?
      ;;
    snippet)
      # shellcheck source=/dev/null
      source "$target"
      local fn2="snippet::${cmd//[^a-zA-Z0-9_]/_}::main"
      local saved_ctx2=$PVX_LOG_CONTEXT
      PVX_LOG_CONTEXT=$cmd
      if declare -F "$fn2" >/dev/null 2>&1; then
        "$fn2" ${cmd_args[@]+"${cmd_args[@]}"} && rc=0 || rc=$?
      else
        log::error 'snippet %s não define %s' "$cmd" "$fn2"
        rc=70
      fi
      PVX_LOG_CONTEXT=$saved_ctx2
      ;;
  esac

  log::debug "comando '%s' finalizado rc=%d" "$cmd" "$rc"
  exit "$rc"
}

main "$@"
